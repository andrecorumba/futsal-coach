{
  "name": "futsal-coach",
  "private": true,
  "version": "0.1.0",
  "description": "Prancheta de futsal para técnicas: escalação, substituições por arrasto, cronômetro e tempo em quadra.",
  "license": "MIT",
  "type": "module",
  "scripts": {
